# Application
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side market data
# Keep external API configuration on the server. Do not expose these as NEXT_PUBLIC_* variables.
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

# Jupiter Swap API
# JUPITER_API_KEY must stay server-side and is read by server/jupiter/adapter.ts.
JUPITER_API_BASE=https://api.jup.ag
JUPITER_API_KEY=
READONLY_TAKER_WALLET=

# Solana RPC endpoints
SOLANA_MAINNET_RPC_URL=

# Persistence / observability
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Optional provider-issued CA PEM, verified out of band. Never disable TLS verification.
DATABASE_CA_CERT=
SENTRY_DSN=

# Wallet authentication: required for wallet-scoped requests.
# Fixed public origin, without trailing slash. Use HTTPS in production.
SIEVE_APP_ORIGIN=http://localhost:3000
# Generate at least 32 random bytes with a secure password generator; server only.
WALLET_SESSION_SECRET=
# Set ONLY if ingress overwrites this header and direct origin access is blocked.
# Empty uses a shared per-process anonymous quota. Deploy a shared/WAF quota too.
TRUSTED_CLIENT_IP_HEADER=
